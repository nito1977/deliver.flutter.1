{
  "name": "fsp",
  "displayName": "FSP",
  "version": "1.0.0",
  "description": "F.S.Patín",
  "main": "index.js",
  "license": "Apache-2.0",
  "scripts": {
    "release": "ng build --configuration production && cordova build android --release",
    "ng": "ng",
    "ngbuild": "ng build",
    "start": "ng serve --host 0.0.0.0 --port 4200 --disable-host-check",
    "startCordova": "ng build && cordova run browser",
    "build": "ng build --configuration production --base-href /app21/",
    "buildCordova": "ng build --configuration production --base-href /app21/  && cordova build android",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "deploy": "node deploy.js",
    "deploy:backend": "node deploy.js --backend"
  },
  "author": "aromero",
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/cdk": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/google-maps": "^18.2.0",
    "@angular/material": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "bootstrap": "^5.3.3",
    "cordova": "^12.0.0",
    "cordova-android": "^13.0.0",
    "cordova-browser": "^7.0.0",
    "cordova-plugin-background-mode": "^0.7.3",
    "cordova-plugin-badge": "^0.8.9",
    "cordova-plugin-device": "^3.0.0",
    "cordova-plugin-geolocation": "^5.0.0",
    "cordova-plugin-local-notification": "^0.9.0-beta.3",
    "cordova-plugin-splashscreen": "^6.0.2",
    "cordova-plugin-statusbar": "^4.0.0",
    "core-js": "^3.38.0",
    "font-awesome": "^4.7.0",
    "jquery": "^3.7.1",
    "js-sha1": "^0.7.0",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.2",
    "ngx-pagination": "^6.0.3",
    "popper.js": "^1.16.1",
    "rxjs": "^7.8.1",
    "sweetalert2": "^11.26.17",
    "tslib": "^2.6.2",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.0",
    "@angular/cli": "^18.2.0",
    "@angular/compiler-cli": "^18.2.0",
    "@angular/language-service": "^18.2.0",
    "@types/jasmine": "~5.1.4",
    "@types/node": "^20.17.0",
    "ftp-deploy": "^2.4.7",
    "jasmine-core": "~5.1.2",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.5.4"
  },
  "cordova": {
    "plugins": {
      "cordova-plugin-splashscreen": {},
      "cordova-plugin-geolocation": {
        "GEOLOCATION_USAGE_DESCRIPTION": "Se usará cuando usted indique que el pedido sea llevado a su ubicación actual."
      },
      "cordova-plugin-background-mode": {},
      "cordova-plugin-whitelist": {}
    },
    "platforms": [
      "browser"
    ]
